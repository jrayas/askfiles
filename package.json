{
	"name": "askfiles",
	"version": "0.1.1",
	"description": "Create notes through a calm, question-by-question flow using your vault folders as the choices.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . && stylelint --max-warnings 0 styles.css",
		"lint:css": "stylelint --max-warnings 0 styles.css",
		"test": "node --test tests/*.test.mjs",
		"vault:create": "node scripts/create-vault.mjs",
		"debug:launch": "node scripts/cdp-debug.mjs launch",
		"debug": "node scripts/cdp-debug.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"notes",
		"folders"
	],
	"author": "Anthirayas",
	"license": "0BSD",
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/node": "^22.10.0",
		"esbuild": "0.28.2",
		"eslint": "9.39.4",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "^16.0.0",
		"jiti": "^2.4.2",
		"obsidian": "1.14.4",
		"stylelint": "17.16.0",
		"stylelint-no-unsupported-browser-features": "8.1.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.2"
	}
}
